@model Habitacion
@{
    ViewData["Title"] = "Editar habitación";
}

<div class="pagina">
    <header class="cabecera">
        <div>
            <p class="etiqueta">Habitación @Model.Numero</p>
            <h1>Editar habitación</h1>
        </div>
    </header>

    <form asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="formulario">
        <input type="hidden" asp-for="IdHabitacion" />
        <partial name="_Form" model="Model" />
        <div class="botones">
            <button class="boton">Guardar cambios</button>
            <a class="vinculo" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
