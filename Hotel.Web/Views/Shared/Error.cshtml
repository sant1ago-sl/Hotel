@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="pagina">
    <header class="cabecera">
        <div>
            <p class="etiqueta">Error</p>
            <h1>Algo no ha salido bien</h1>
        </div>
    </header>

    <p>No se pudo completar la solicitud. Inténtelo de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="intro" style="color: var(--suave);">Código de solicitud: <code>@Model.RequestId</code></p>
    }

    <a class="boton claro" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
